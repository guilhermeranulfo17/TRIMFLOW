# ---------------------------------------------------------------------------
# Orkestra: variáveis de ambiente
# Copie para .env.local (nunca versione .env.local).
# Local: os valores saem de `pnpm exec supabase status` depois de `pnpm db:start`.
# ---------------------------------------------------------------------------

# URL da API do Supabase (local: http://127.0.0.1:54321; cloud: https://<ref>.supabase.co).
# Pública: vai para o navegador. Na Vercel precisa existir ANTES do build (é embutida no bundle).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública do Supabase ("anon" ou "publishable"). Pode ir para o navegador: o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# URL pública do app, sem barra no final. Usada nos links dos e-mails (recuperação de senha).
# Local: http://localhost:3000; preview/produção: a URL da Vercel ou o domínio próprio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conexão Postgres usada pelo Drizzle no SERVIDOR. Secreta: nunca use prefixo NEXT_PUBLIC_.
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud/Vercel: use a string do pooler (Supavisor, modo transação, porta 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Chave service role (secreta). Usada SÓ em src/server/auth/admin-supabase.ts para criar,
# bloquear e liberar vendedores (Minha empresa → Usuários). Nunca com prefixo NEXT_PUBLIC_.
# Local: "service_role key" de `pnpm exec supabase status`. Vercel: Settings → API do Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Sal do hash de IP do link público: guardamos só sha256(ip + IP_HASH_SALT), nunca o IP.
# Secreta e OBRIGATÓRIA em produção (o servidor não sobe sem ela). Gere com: openssl rand -hex 32
# Local: qualquer texto (sem ela, em desenvolvimento usa um valor fixo).
IP_HASH_SALT=

# --- Avisos (Etapa 7) -----------------------------------------------------------
# Segredo da rota /api/avisos/processar (o pg_cron chama com "Authorization: Bearer <segredo>").
# OBRIGATÓRIA em produção para a fila rodar pelo job (sem ela, o site sobe, a rota recusa tudo
# e só os avisos imediatos saem pelo after()). O MESMO valor vai para o Vault do Supabase
# (orkestra_cron_secret). Gere com: openssl rand -hex 32
CRON_SECRET=

# Push no celular (Web Push, VAPID). Gere o par com: pnpm vapid:gerar
# Sem as três, o push fica desligado (o painel continua recebendo os avisos).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seu-dominio.com.br

# WhatsApp oficial (Meta Cloud API). OPCIONAIS: vazias = canal desligado, nada quebra.
# Token permanente de usuário do sistema e o ID do número (WhatsApp Manager → API Setup).
# Modelos a aprovar na Meta: docs/WHATSAPP_MODELOS.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Cobrança (Etapa 9A) ---------------------------------------------------------
# Asaas (API via fetch, sem SDK). Sem as três, a cobrança fica desligada e a tela de Plano
# mostra "Fale com a gente no WhatsApp". Chave e token são SECRETOS (nunca NEXT_PUBLIC_).
# Passo a passo (sandbox → produção) em docs/COBRANCA.md.
ASAAS_API_KEY=
# sandbox | producao
ASAAS_AMBIENTE=sandbox
# Token que você define no webhook do Asaas (vem no header asaas-access-token). Gere com:
# openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=
# Só testes: com ASAAS_AMBIENTE=sandbox, aponta para a API falsa (tests/support/asaas-fake*).
# ASAAS_API_URL=http://localhost:4010/v3

# WhatsApp de vendas do Orkestra (landing e botão "Fale com a gente" quando a cobrança está
# desligada). Só dígitos com DDI, ex.: 5534999999999.
NEXT_PUBLIC_WHATSAPP_VENDAS=

# Landing (Etapa 9.6), todas opcionais: slug de um buffet de demonstração em produção (sem ela, o
# botão "Ver um buffet de exemplo" some), e-mail de contato e razão social no rodapé.
# NEXT_PUBLIC_DEMO_SLUG=
# NEXT_PUBLIC_EMAIL_CONTATO=
# NEXT_PUBLIC_RAZAO_SOCIAL=

# E-mails da equipe Orkestra com acesso ao /interno, separados por vírgula. O /interno exige
# também o código de verificação (TOTP), cadastrado no primeiro acesso. Os usuários da equipe
# são criados no painel do Supabase (Authentication → Users → Add user), sem empresa.
ORKESTRA_ADMINS=

# --- Só para testes -----------------------------------------------------------
# Banco dos testes de integração (padrão: DATABASE_URL ou o Supabase local).
# TEST_DATABASE_URL=
# TEST_DB_SHIM=1 recria do zero um Postgres puro "*_test" com um shim do schema auth
# (para rodar a integração sem Docker). Ver tests/support/global-setup.ts.
# TEST_DB_SHIM=
# Caixa de e-mails de teste (Mailpit do Supabase local), usada no E2E de recuperação de senha.
# MAILPIT_URL=http://127.0.0.1:54324
# Chromium já instalado na máquina (evita download do Playwright).
# PLAYWRIGHT_CHROMIUM_PATH=

# Etapa 9.5: "Continuar com o Google" em /login e /cadastro. Só ligue depois de configurar o
# provedor no Supabase (docs/LOGIN_GOOGLE.md). Não é segredo.
# NEXT_PUBLIC_LOGIN_GOOGLE=1
